# Copy to .env (gitignored) and fill in. Placeholders only: never commit real values.
# NEVER put a private key, mnemonic, seed or password in .env or any file. script/deploy.sh refuses if you do.

# --- Network (QIE testnet, docs.qie.digital "Access Mainnet or Testnet") ---
QIE_RPC_URL=https://rpc2testnet.qie.digital/
# rpc1testnet failed TLS on 1 Nov 2026. Fallbacks: https://rpc4testnet.qie.digital/, https://rpc5testnet.qie.digital/
POC_EXPECTED_CHAIN_ID=1983

# --- Signer (choose one) ---
# Funded address that signs the deploy; checked against the actual signer.
POC_EXPECTED_DEPLOYER=0x0000000000000000000000000000000000000000
# Foundry keystore name (create with: cast wallet import <name> --interactive). Password is prompted.
POC_KEYSTORE_ACCOUNT=
# Or a hardware wallet:
# POC_LEDGER=yes
# Testnet-only fallback: export DEPLOYER_PRIVATE_KEY in your shell session, never here.

# --- ProofOfCall constructor ---
# Owner of the contract (manages the feed allowlist and defaults for new seals).
POC_OWNER=0x0000000000000000000000000000000000000000
# Max seconds between a target time and the proving oracle round (60 .. 604800). 21600 = 6 h.
POC_MAX_GAP=21600
# |exit - entry| within this many bps counts as FLAT (0 .. 1000). 10 = 0.10 %.
POC_FLAT_BAND_BPS=10

# --- Feeds ---
# Testnet: one MockAggregatorV3 per description (1 .. 8), admin = the deployer.
POC_MOCK_FEEDS="BTC / USD,ETH / USD"
# Mainnet only (not used in Q2): official QIE Oracle feed addresses, comma separated.
# POC_FEEDS=

# --- Mainnet guard (leave unset; mainnet is the owner's own step in Q11) ---
# POC_MAINNET_GO=

# --- Post-deploy check (script/Check.s.sol), filled in from the deploy output ---
POC_ADDRESS=0x0000000000000000000000000000000000000000
POC_CHECK_FEEDS=0x0000000000000000000000000000000000000000
POC_MOCK_ADMIN=0x0000000000000000000000000000000000000000
